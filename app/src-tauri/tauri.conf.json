{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpiderLens",
  "mainBinaryName": "spiderlens-desktop",
  "identifier": "com.ryware.spiderlens",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "pnpm --filter spiderlens-ui dev",
    "beforeBuildCommand": "pnpm --filter spiderlens-ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SpiderLens",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 24 }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "SEO crawler",
    "publisher": "Ryware"
  },
  "plugins": {}
}
